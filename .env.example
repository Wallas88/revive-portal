# Copy to .env for local development (never commit .env).
NODE_ENV=development
PORT=4180
HOST=127.0.0.1

# Both paths sit on one persistent volume in production (Render disk: /var/data).
DATABASE_PATH=./data/revive-portal.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

SESSION_HOURS=12

# Public origin used in invitation and password-reset links.
APP_URL=http://127.0.0.1:5177

# Optional: email delivery through Resend. Without a key, invite/reset links
# are shown to the admin to send by hand.
# RESEND_API_KEY=
EMAIL_FROM=Revive Portal <portal@siterevivesa.com>
